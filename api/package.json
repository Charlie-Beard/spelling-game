{
  "name": "wizard-words-api",
  "private": true,
  "description": "Cloud save for Wizard Words: sign-in plus progress and settings sync (Cloudflare Worker + D1).",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
