    {
      "id": "1x5t2vp",
      "text": "Welcome to Wizard Words!",
      "speaker": "narrator"
    },
    {
      "id": "19455hi",
      "text": "Who do you want to be?",
      "speaker": "narrator"
    },
    {
      "id": "ccvp7u",
      "text": "Harry Potter!",
      "speaker": "narrator"
    },
    {
      "id": "1fi20vj",
      "text": "Ron Weasley!",
      "speaker": "narrator"
    },
    {
      "id": "y16pab",
      "text": "Hermione Granger!",
      "speaker": "narrator"
    },
    {
      "id": "116n8nh",
      "text": "Let’s go!",
      "speaker": "narrator"
    },
    {
      "id": "ujnztm",
      "text": "Can you spell…",
      "speaker": "narrator"
    },
    {
      "id": "1ov17dm",
      "text": "Listen…",
      "speaker": "narrator"
    },
    {
      "id": "18d4qj7",
      "text": "Hmm, try another one.",
      "speaker": "narrator"
    },
    {
      "id": "16ba1dz",
      "text": "Listen to the sound…",
      "speaker": "narrator"
    },
    {
      "id": "1nhz3y1",
      "text": "Hedwig can help!",
      "speaker": "narrator"
    },
    {
      "id": "vp2a8t",
      "text": "Here you go!",
      "speaker": "narrator"
    },
    {
      "id": "le3t5h",
      "text": "You finished the chapter!",
      "speaker": "narrator"
    },
    {
      "id": "17tg8zn",
      "text": "You got a new wizard card!",
      "speaker": "narrator"
    },
    {
      "id": "6ptbcb",
      "text": "You found a Horcrux!",
      "speaker": "narrator"
    },
    {
      "id": "1yrow8r",
      "text": "Spell each word to cast a shield!",
      "speaker": "narrator"
    },
    {
      "id": "1h586n5",
      "text": "You saved Hogwarts! Expelliarmus!",
      "speaker": "narrator"
    },
    {
      "id": "qyvcus",
      "text": "Great work! Time for a little break.",
      "speaker": "narrator"
    },
    {
      "id": "19cm7lq",
      "text": "Please turn the iPad sideways.",
      "speaker": "narrator"
    },
    {
      "id": "1caejgi",
      "text": "Ready for the next one?",
      "speaker": "narrator"
    },
    {
      "id": "dos1g8",
      "text": "Hooray! All done!",
      "speaker": "narrator"
    },
    {
      "id": "10m1apz",
      "text": "Brilliant!",
      "speaker": "narrator"
    },
    {
      "id": "gn8ww",
      "text": "Well done!",
      "speaker": "narrator"
    },
    {
      "id": "bd280t",
      "text": "Wicked!",
      "speaker": "narrator"
    },
    {
      "id": "1qhyaqz",
      "text": "Amazing spelling!",
      "speaker": "narrator"
    },
    {
      "id": "1ie9iyr",
      "text": "Fantastic!",
      "speaker": "narrator"
    },
    {
      "id": "1m9m385",
      "text": "Super!",
      "speaker": "narrator"
    },
    {
      "id": "zu1pt3",
      "text": "Ten points to Gryffindor!",
      "speaker": "narrator"
    },
    {
      "id": "px2c4b",
      "text": "Spell-tastic!",
      "speaker": "narrator"
    },
    {
      "id": "1p30gsx",
      "text": "You did it!",
      "speaker": "narrator"
    },
    {
      "id": "1hzi10n",
      "text": "Magic!",
