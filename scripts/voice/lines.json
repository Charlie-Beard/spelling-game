    },
    {
      "id": "1b85i8d",
      "text": "Book 1: The Philosopher's Stone!",
      "speaker": "narrator"
    },
    {
      "id": "1ulfpge",
      "text": "Book 2: The Chamber of Secrets!",
      "speaker": "narrator"
    },
    {
      "id": "40p4m6",
      "text": "Book 3: The Prisoner of Azkaban!",
      "speaker": "narrator"
    },
    {
      "id": "1icnfug",
      "text": "Book 4: The Goblet of Fire!",
      "speaker": "narrator"
    },
    {
      "id": "gqjivi",
      "text": "Book 5: The Order of the Phoenix!",
      "speaker": "narrator"
    },
    {
      "id": "1fva6or",
      "text": "Book 6: The Half-Blood Prince!",
      "speaker": "narrator"
    },
    {
      "id": "s1kbfs",
      "text": "Book 7: The Deathly Hallows!",
      "speaker": "narrator"
    },
    {
      "id": "ksa1q5",
      "text": "Hello there! I’m Hagrid. Can you help me tidy up my hut?",
      "speaker": "hagrid"
    },
    {
      "id": "1g6k4x",
      "text": "Hagrid’s Hut",
      "speaker": "narrator"
    },
    {
      "id": "1my3rvv",
      "text": "Welcome to Diagon Alley! Let’s find everything you need for school.",
      "speaker": "ollivander"
    },
    {
      "id": "jefoy6",
      "text": "Diagon Alley",
      "speaker": "narrator"
    },
    {
      "id": "ubh4bv",
      "text": "Ribbit! I’m Trevor the toad. I hopped all over the train. Help me find these!",
      "speaker": "trevor"
    },
    {
      "id": "gpoi5b",
      "text": "The Hogwarts Express",
      "speaker": "narrator"
    },
    {
      "id": "xpupj",
      "text": "Good evening! I’m Nearly Headless Nick. Let’s spell the feast!",
      "speaker": "nick"
    },
    {
      "id": "1rxbubx",
      "text": "The Great Hall Feast",
      "speaker": "narrator"
    },
    {
      "id": "1sezzb4",
      "text": "I have hidden a ring. You will never find it… unless you can spell!",
      "speaker": "voldemort"
    },
    {
      "id": "14tf5u",
      "text": "The Hidden Ring",
      "speaker": "narrator"
    },
    {
      "id": "128vgum",
      "text": "Dobby has come to help! Dobby likes socks very much.",
      "speaker": "dobby"
    },
    {
      "id": "xd2k53",
      "text": "Dobby’s Warning",
      "speaker": "narrator"
    },
    {
      "id": "7fw2ya",
      "text": "Oi! A garden gnome, that’s me. Let’s spell things at the Burrow.",
      "speaker": "gnome"
    },
    {
      "id": "n5czbb",
      "text": "The Burrow",
      "speaker": "narrator"
    },
    {
      "id": "1ydkjpj",
      "text": "Who crashed a car into ME? Spell these words and I’ll calm down.",
      "speaker": "willow"
    },
    {
      "id": "gv0l8l",
      "text": "The Flying Car",
      "speaker": "narrator"
    },
    {
      "id": "invcst",
      "text": "Fawkes the phoenix sings a song. Spell these words to make him glow!",
      "speaker": "fawkes"
    },
    {
      "id": "1jfeojm",
      "text": "Fawkes the Phoenix",
      "speaker": "narrator"
    },
    {
      "id": "1wcc7bm",
      "text": "Hissss… The diary is down in the Chamber. Spell bravely to find it.",
      "speaker": "basilisk"
    },
    {
      "id": "1dsxqp1",
      "text": "The Secret Diary",
      "speaker": "narrator"
    },
    {
      "id": "11q8hul",
      "text": "Mrrow. I am Crookshanks. I like chasing things. Spell what I chase!",
      "speaker": "crookshanks"
    },
    {
      "id": "10s3mzo",
      "text": "Hello, I’m Professor Lupin. Have some chocolate, then let’s spell!",
      "speaker": "lupin"
    },
    {
      "id": "15m03pu",
      "text": "Bow to Buckbeak the hippogriff… he bows back! Now spell these.",
      "speaker": "buckbeak"
    },
    {
      "id": "hed4dh",
      "text": "Squeak! I know where the locket is. But you’ll have to spell for it!",
      "speaker": "wormtail"
    },
    {
      "id": "1hacv8q",
      "text": "The Lost Locket",
      "speaker": "narrator"
    },
    {
      "id": "1poldt2",
      "text": "Constant vigilance! I’m Mad-Eye Moody. Keep your eyes on these words.",
      "speaker": "moody"
    },
    {
      "id": "1f1yx1x",
      "text": "The Quidditch World Cup",
      "speaker": "narrator"
    },
    {
      "id": "10lg9sf",
      "text": "ROAR! I’m the Hungarian Horntail. Spell these and I’ll guard my golden egg.",
      "speaker": "horntail"
    },
    {
      "id": "yfm08k",
      "text": "The Dragon Task",
      "speaker": "narrator"
    },
    {
      "id": "1mq2n7s",
      "text": "Oooh, a visitor! I’m Moaning Myrtle. Help me with these words.",
      "speaker": "myrtle"
    },
    {
      "id": "cdz4u8",
      "text": "The Black Lake",
      "speaker": "narrator"
    },
    {
      "id": "6jese2",
      "text": "Ha ha! The golden cup is MINE. Spell well if you want to take it.",
      "speaker": "bellatrix"
    },
    {
      "id": "nds4n3",
      "text": "Welcome to my house! I’m Sirius, Harry’s godfather. Let’s spell!",
      "speaker": "sirius"
    },
    {
      "id": "javk6k",
      "text": "Grimmauld Place",
      "speaker": "narrator"
    },
    {
      "id": "15my7cv",
      "text": "Hello. I’m Luna. I can see lovely creatures. Can you spell them?",
      "speaker": "luna"
    },
    {
      "id": "8hzz43",
      "text": "I’m Neville. We practise spells in secret. Let’s practise spelling too!",
      "speaker": "neville"
    },
    {
      "id": "1nhfa19",
      "text": "Dumbledore’s Army",
      "speaker": "narrator"
    },
    {
      "id": "b4k2ga",
      "text": "The Death Eaters are hiding the diadem. Spell to sneak past them!",
      "speaker": "deatheater"
    },
    {
      "id": "1bzo70s",
      "text": "The Lost Diadem",
      "speaker": "narrator"
    },
    {
      "id": "wnj9ar",
      "text": "Ah, a new student! I’m Professor Slughorn. Let’s brew some spelling!",
      "speaker": "slughorn"
    },
    {
      "id": "3nas7j",
      "text": "Slughorn’s Potions",
      "speaker": "narrator"
    },
    {
      "id": "1ibhjg2",
      "text": "Hello, I am Professor Dumbledore. Come with me to the cave, and spell.",
      "speaker": "dumbledore"
    },
    {
      "id": "2177rb",
      "text": "The Crystal Cave",
      "speaker": "narrator"
    },
    {
      "id": "1qamnv1",
      "text": "Hi! I’m Ginny, the best flyer in Gryffindor. Ready for practice?",
      "speaker": "ginny"
    },
    {
      "id": "k48sa7",
      "text": "Quidditch Practice",
      "speaker": "narrator"
    },
    {
      "id": "opg03a",
      "text": "Sssss. I am Nagini. Spell very carefully… if you dare.",
      "speaker": "nagini"
    },
    {
      "id": "9ri8a3",
      "text": "The Great Snake",
      "speaker": "narrator"
    },
    {
      "id": "1bjcwz7",
      "text": "Kreacher will help Master. Kreacher has packed a picnic.",
      "speaker": "kreacher"
    },
    {
      "id": "cgjbrw",
      "text": "Kreacher’s Kitchen",
      "speaker": "narrator"
    },
    {
      "id": "1skt8hj",
      "text": "I am Griphook the goblin. Spell well and I’ll open the vault.",
      "speaker": "griphook"
    },
    {
      "id": "nnt46a",
      "text": "Gringotts Bank",
      "speaker": "narrator"
    },
    {
      "id": "1ces7iq",
      "text": "I am Professor McGonagall. Hogwarts needs you. Let’s get ready!",
      "speaker": "mcgonagall"
    },
    {
      "id": "zohmaw",
      "text": "Back to Hogwarts",
      "speaker": "narrator"
    },
    {
      "id": "m95twi",
      "text": "The Death Eaters are coming! Spell each word to cast a shield over the castle.",
      "speaker": "voldemort"
    },
    {
      "id": "jrglie",
      "text": "The Battle of Hogwarts",
      "speaker": "narrator"
    }
  ]
}